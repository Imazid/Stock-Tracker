//
//  SecretsConfig.swift.template
//  Stock Tracker
//
//  Copy to SecretsConfig.swift (git-ignored):
//      cp "Stock Tracker/SecretsConfig.swift.template" "Stock Tracker/SecretsConfig.swift"
//  It reads Config/Secrets.plist (also git-ignored; template: Config/Secrets.plist.example).
//  A missing plist or key reads as "", so a clean checkout builds and runs with features
//  that need a key showing their not-configured state. CI uses this file as-is.
//
//  Every value in Secrets.plist ships inside the app bundle. Server-grade secrets
//  (SnapTrade consumer key, OpenAI, Gemini) belong in Supabase Edge Function secrets.
//
import Foundation

enum SecretsConfig {
    private static let plist: [String: Any] = {
        guard let url = Bundle.main.url(forResource: "Secrets", withExtension: "plist"),
              let data = try? Data(contentsOf: url),
              let dict = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any]
        else { return [:] }
        return dict
    }()
    private static func value(_ key: String) -> String { plist[key] as? String ?? "" }

    static var alpacaAPIKey: String { value("AlpacaAPIKey") }
    static var alpacaSecretKey: String { value("AlpacaSecretKey") }
    static var alphaVantageKey: String { value("AlphaVantageKey") }
    static var finnhubAPIKey: String { value("FinnhubAPIKey") }
    static var snapTradeClientId: String { value("SnapTradeClientId") }
    static var snapTradeConsumerKey: String { value("SnapTradeConsumerKey") }
    static var openAIAPIKey: String { value("OpenAIAPIKey") }
    static var geminiAPIKey: String { value("GeminiAPIKey") }
    static var coinGeckoAPIKey: String { value("CoinGeckoAPIKey") }
    static var fmpAPIKey: String { value("FMPAPIKey") }
    static var fiscalAIAPIKey: String { value("FiscalAIAPIKey") }
    static var supabaseURL: String { value("SupabaseURL") }
    static var supabaseAnonKey: String { value("SupabaseAnonKey") }
}
