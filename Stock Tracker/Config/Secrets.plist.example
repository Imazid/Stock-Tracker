<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Debug builds copy this file for local development.
      Release builds copy only SupabaseURL and SupabaseAnonKey.
      See docs/DEPLOYMENT.md for the server-side provider secrets.
    -->

    <!-- Alpaca Market Data — use keys from a DEDICATED UNFUNDED PAPER account only:
         an Alpaca key pair also authorises trading on its account. https://alpaca.markets -->
    <key>AlpacaAPIKey</key>
    <string>YOUR_ALPACA_API_KEY</string>

    <key>AlpacaSecretKey</key>
    <string>YOUR_ALPACA_SECRET_KEY</string>

    <!-- Alpha Vantage — https://www.alphavantage.co -->
    <key>AlphaVantageKey</key>
    <string>YOUR_ALPHA_VANTAGE_KEY</string>

    <!-- Finnhub — https://finnhub.io -->
    <key>FinnhubAPIKey</key>
    <string>YOUR_FINNHUB_API_KEY</string>

    <!-- SnapTrade — https://snaptrade.com -->
    <key>SnapTradeClientId</key>
    <string>YOUR_SNAPTRADE_CLIENT_ID</string>

    <!-- DEBUG BUILDS ONLY, and only while no Supabase project is configured.
         Leave empty once snaptrade-proxy is deployed: this key signs for every user. -->
    <key>SnapTradeConsumerKey</key>
    <string></string>

    <!-- OpenAI — DEBUG BUILDS ONLY without a server; leave empty once ai-proxy is deployed. -->
    <key>OpenAIAPIKey</key>
    <string></string>

    <!-- Google Gemini — DEBUG BUILDS ONLY without a server; leave empty once ai-proxy is deployed. -->
    <key>GeminiAPIKey</key>
    <string></string>

    <!-- CoinGecko Demo — https://www.coingecko.com/en/api -->
    <key>CoinGeckoAPIKey</key>
    <string>YOUR_COINGECKO_DEMO_KEY</string>

    <!-- Financial Modeling Prep — https://financialmodelingprep.com -->
    <key>FMPAPIKey</key>
    <string>YOUR_FMP_API_KEY</string>

    <!-- Fiscal.ai — https://fiscal.ai -->
    <key>FiscalAIAPIKey</key>
    <string>YOUR_FISCAL_AI_API_KEY</string>

    <!-- Supabase — the anon key is designed to be public (RLS protects the data).
         Stock Tracker project: https://opruuwczvrwklmwdtsaw.supabase.co -->
    <key>SupabaseURL</key>
    <string>https://YOUR_PROJECT_REF.supabase.co</string>

    <key>SupabaseAnonKey</key>
    <string>YOUR_SUPABASE_ANON_KEY</string>
</dict>
</plist>
