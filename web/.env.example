# Copy to .env.local and fill in. Never commit real values.
# Supabase project (accounts, watchlists, order routing). Leave empty to run with public market data only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alpaca market data (US equities on the IEX feed, crypto). Read-only data keys — never trading keys.
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET=
# CoinGecko Demo API key (optional; without it CoinGecko rate-limits after a few calls a minute).
COINGECKO_API_KEY=
# Claude API key for the AI Workspace. Keep it server-side.
ANTHROPIC_API_KEY=

# Used when Anthropic is unavailable in this deployment configuration.
OPENAI_API_KEY=

# Stock Tracker workspace
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
WORKSPACE_OVERVIEW_SECRET=
ENABLE_AI=false
ENABLE_SNAPTRADE=false
