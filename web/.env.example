# Copy to .env.local and fill in. Never commit real values.
# Supabase project (accounts, watchlists, order routing). Leave empty to run with public market data only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alpaca market data (US equities on the IEX feed, crypto). Read-only data keys — never trading keys.
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET=
# CoinGecko Demo API key (optional; without it CoinGecko rate-limits after a few calls a minute).
COINGECKO_API_KEY=
# Claude API key for the AI workspace and company research panel.
ANTHROPIC_API_KEY=

# Used when Anthropic is unavailable in this deployment configuration.
OPENAI_API_KEY=

# Stock Tracker workspace
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
WORKSPACE_OVERVIEW_SECRET=
ENABLE_AI=false
ENABLE_SNAPTRADE=false

# Company research. Use your application's name and a real operator contact, as required by SEC fair access.
RESEARCH_SEC_USER_AGENT=
# Optional persistence for public SEC facts. Apply the research migration first. Never expose this key to clients.
RESEARCH_SUPABASE_SERVICE_ROLE_KEY=
# Enable display only for datasets covered by your provider agreement.
RESEARCH_FMP_API_KEY=
RESEARCH_FMP_DISPLAY=false
RESEARCH_MASSIVE_API_KEY=
RESEARCH_MASSIVE_DISPLAY=false
# Enable separately if your provider agreement permits sending data to the AI model.
RESEARCH_FMP_AI=false
RESEARCH_MASSIVE_AI=false
# Scheduled company alerts. Configure the same bearer token at the scheduler.
CRON_SECRET=
# Enable only when news headlines and links may be retained in the alert inbox.
RESEARCH_FMP_ALERTS=false

# Public privacy contact shown at /privacy. Set to an approved, monitored address before publication.
STOCK_TRACKER_PRIVACY_EMAIL=
