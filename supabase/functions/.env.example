# Edge-function secrets (set with `supabase secrets set` for a hosted project, or
# supabase/functions/.env for `supabase functions serve`). Names only — never commit values.

# Provided by Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=

# Market data used by the risk checks (read-only keys)
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET=
COINGECKO_API_KEY=

# Credential vault key ring for broker-connections / broker-orders.
# {"active":"k1","keys":{"k1":"<base64 of 32 random bytes>"}}
# Generate a key: openssl rand -base64 32. Rotate by adding k2, making it active, then
# re-wrapping (vault/envelope.ts rewrap) before removing k1.
BROKER_CREDENTIALS_KEKS=

# Tests only: let trading-api accept fixture market data
TRADING_ALLOW_FIXTURE_DATA=
